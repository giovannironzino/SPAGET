rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default Deny All
    match /{document=**} {
      allow read, write: if false;
    }

    // Check if user is authenticated and verified
    function isSignedIn() {
      return request.auth != null;
    }

    // Validate cycle document structure
    function isValidCycle(data) {
      return data.userId is string 
        && data.userId.size() <= 128
        && data.createdAt is string
        && data.currentStage is string
        && data.currentStage.size() <= 32;
    }

    // Secure Cycles collection
    match /cycles/{cycleId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() 
        && isValidCycle(request.resource.data)
        && request.resource.data.userId == request.auth.uid;

      allow update: if isSignedIn()
        && resource.data.userId == request.auth.uid
        && isValidCycle(request.resource.data)
        && request.resource.data.userId == request.auth.uid;

      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Preferências alimentares por usuário
    match /user_food_preferences/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    // Perfis e controle de permissões (Usuário não pode se auto-promover a Admin)
    match /user_profiles/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == uid && request.resource.data.role == 'user';
      allow update: if isSignedIn() && request.auth.uid == uid && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    // Configuração mestre do sistema (Apenas administradores com role=='admin' podem alterar)
    match /system_config/{configId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() 
        && exists(/databases/$(database)/documents/user_profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/user_profiles/$(request.auth.uid)).data.role == 'admin';
    }
  }
}
